<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>noharness-demo</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <!--
    A minimal, stdlib-only Java target for RAKSHA AI's "no hand-written harness" Java lane.

    It ships a single public entry point — Parser.parse(byte[]) — and NO fuzz driver. The Java
    deep lane discovers the entry point, synthesizes a driver that decodes the input file to a
    byte[] and calls parse(), and an over-claiming length-prefixed record makes the JVM throw
    ArrayIndexOutOfBoundsException. RAKSHA's JazzerOracle parses the driver's exception banner
    into a finding; the template lane clamps the index; the five-check gate proves the fix.

    No external deps beyond JUnit, which is already warm in ~/.m2. Plugin versions are pinned to
    the cached ones so `mvn -o` resolves with no network.
  -->
  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.7.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
